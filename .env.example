# 默认 DEMO_MODE：不填下面任何云配置，DEMO-001 用确定性规则引擎走通。
# 推荐的自建栈是 DeepSeek 或 Ollama + SMTP + MinIO + Postgres/SQLite。
# Amazon Bedrock / SES / DynamoDB / S3 仍可作为 CDS 比赛的可选遗留路径，默认不会启用。
APP_MODE=demo
DEMO_MODE=true
AWS_MODE=false

# 核对引擎：
#   auto（或留空）= deepseek → ollama → gateway → deterministic，跳过 Bedrock
#   deepseek | ollama | gateway | deterministic | bedrock
# bedrock 只有在显式 REVIEW_ENGINE=bedrock 时才会调用。失败不会改标成别的引擎。
REVIEW_ENGINE=auto

# DeepSeek（OpenAI 兼容）。不要把密钥提交到 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Ollama（开源，本机）。OLLAMA_MODEL 有值才算已配置；地址默认本机 /v1。
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
# OLLAMA_API_KEY=

# 可选：Vercel AI Gateway。engine 标成 ai_gateway，不会标成 bedrock / deepseek。
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=amazon/nova-lite

# 发信：SMTP（Postal、Mailu、Haraka、docker-mailserver，或本地 Mailpit）。
# SMTP_HOST + SMTP_FROM 齐全才真发。成功只记 submit_succeeded，不是已投递。
# 两者都空时，DEMO 外发保持 recorded_not_sent。
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SECURE=false
# SMTP_REPLY_TO=

# 对象存储：MinIO 或其他 S3 兼容服务。force path style 对 MinIO 应为 true。
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# 不配 MinIO 时，可把原始 MIME 放到本地目录（MAIL_STORE=disk 或设置 MAIL_DIR）。
# MAIL_STORE=disk
# MAIL_DIR=.data/mail

# 持久化：有 DATABASE_URL 时用 Postgres；否则 PERSISTENCE=sqlite 用 .data/orders.sqlite；否则内存。
# DATABASE_URL=postgres://ordercheck:ordercheck@127.0.0.1:5432/ordercheck
# PERSISTENCE=sqlite
# SQLITE_PATH=.data/orders.sqlite

# 保护 POST /api/aws/inbound、POST /api/inbound/email 与 POST /api/aws/ses-events。
# 未配置时这些接口返回 501。不要把密钥提交到 Git。
INBOUND_WEBHOOK_SECRET=

# --- 可选遗留：AWS CDS 比赛路径（默认不走） ---
# AWS_REGION=
# BEDROCK_MODEL_ID=
# BEDROCK_MAX_TOKENS=2400
# BEDROCK_AGENT_RETRY=1
# ORDERS_TABLE_NAME=
# MESSAGES_TABLE_NAME=
# ISSUE_EVENTS_TABLE_NAME=
# RAW_EMAIL_BUCKET=
# SES_FROM_ADDRESS=
# SES_REPLY_TO_ADDRESS=
# SES_CONFIGURATION_SET=
# INBOUND_DOMAIN=
