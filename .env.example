# demo（默认）或 aws。AWS_MODE=true 等价于 APP_MODE=aws。
# 两者都设了时，只要 AWS_MODE=true 或 APP_MODE=aws，就走 AWS 路径。
APP_MODE=demo
DEMO_MODE=true
AWS_MODE=false

# 核对引擎：deterministic（默认 demo）| bedrock | gateway
# AWS_MODE 下未显式指定时强制 bedrock；失败不会静默回退到规则引擎。
# DEMO 下设 REVIEW_ENGINE=bedrock 或 gateway 且配置齐全时，也可真调模型。
REVIEW_ENGINE=

# Bedrock。不要把密钥写进仓库；本机用 AWS 默认凭证链（AWS_ACCESS_KEY_ID 等）。
AWS_REGION=
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=2400
# 引用校验丢弃过多时，最多再 Converse 一次（默认开）。设 0 关闭。
BEDROCK_AGENT_RETRY=1

# 无 AWS 密钥时的真 LLM 备份（Vercel AI Gateway）。返回 engine=ai_gateway，绝不会标成 bedrock。
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=amazon/nova-lite

# DynamoDB 表名。未配置时继续 Memory。pk=orderId，整单 JSON。
ORDERS_TABLE_NAME=
MESSAGES_TABLE_NAME=
ISSUE_EVENTS_TABLE_NAME=

# SES 与原始邮件。example.com 不能用来真实发信。
# AWS_MODE + SES_FROM_ADDRESS + AWS_REGION 齐全时才会真发；成功仅 submit_succeeded。
RAW_EMAIL_BUCKET=
SES_FROM_ADDRESS=
SES_REPLY_TO_ADDRESS=
SES_CONFIGURATION_SET=
INBOUND_DOMAIN=

# 保护 POST /api/aws/inbound 与 /api/aws/ses-events（Lambda/EventBridge 转发）。
# 未配置时这两个接口返回 501。不要把密钥提交到 Git。
INBOUND_WEBHOOK_SECRET=
